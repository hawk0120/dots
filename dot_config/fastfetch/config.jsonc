{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 5,
      "left": 3,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": "󰌢  PC",
      "keyColor": "#89b4fa",
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 ",
      "keyColor": "#89b4fa",
    },
    {
      "type": "gpu",
      "key": "│ ├󰍹 ",
      "keyColor": "#89b4fa",
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 ",
      "keyColor": "#89b4fa",
    },
    {
      "type": "disk",
      "key": "└ └󰋊 ",
      "keyColor": "#89b4fa",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "kernel",
      "key": "│ ├󰌽 ",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "bios",
      "key": "│ ├󰖡 ",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 ",
      "keyColor": "#a6e3a1",
    },
    {
      "type": "shell",
      "key": "└ └󰞷 ",
      "keyColor": "#a6e3a1",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m┌────────────────────Uptime / Age─────────────────────┐",
    },
    {
      "type": "command",
      "key": "  ›  OS Age  ",
      "keyColor": "#cba6f7",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  ›  Uptime  ",
      "keyColor": "#cba6f7",
    },
    {
      "type": "datetime",
      "key": "  ›  DateTime  ",
      "keyColor": "#cba6f7",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m└─────────────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
